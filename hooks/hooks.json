{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/nedflow-commit-check.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
